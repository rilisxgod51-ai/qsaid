-- ========== Логика сворачивания ==========
local expanded = true
local normalHeight = frame.Size.Y.Offset

local function toggleCollapse()
    expanded = not expanded
    collapseBtn.Text = expanded and "–" or "+"
    if expanded then
        frame.Size = UDim2.new(0, 250, 0, normalHeight)
    else
        frame.Size = UDim2.new(0, 250, 0, 30)
    end
    for _, child in ipairs(frame:GetChildren()) do
        if child ~= title and child ~= collapseBtn then
            child.Visible = expanded
        end
    end
end
collapseBtn.MouseButton1Click:Connect(toggleCollapse)

-- ========== Логика прыжков ==========
local processing = false
local lastJumpTime = nil
local pressedKeys = {}

UserInputService.InputBegan:Connect(function(input, gp)
    if not gp then pressedKeys[input.KeyCode] = true end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if not gp then pressedKeys[input.KeyCode] = nil end
end)

local function getValue(box, default)
    local val = tonumber(box.Text)
    if val == nil or val < 0 then return default end
    return val
end

local function anyJumpEnabled()
    for i = 1, 3 do
        if sections[i].checkBtn.Text:sub(1, 1) == "☑" then return true end
    end
    return false
end

UserInputService.InputBegan:Connect(function(input, gp)
    -- Отладка
    print("Клавиша нажата:", input.KeyCode, "gameprocess:", gp, "enabled:", enabled)

    if input.KeyCode ~= Enum.KeyCode.Q or gp or not enabled then return end

    -- Отладка: какие клавиши сейчас зажаты
    local keys = {}
    for k in pairs(pressedKeys) do table.insert(keys, k) end
    print("Зажатые клавиши:", table.concat(keys, ", "))

    for key, _ in pairs(pressedKeys) do
        if key ~= Enum.KeyCode.Q then print("Другая клавиша:", key, "-> блокируем"); return end
    end

    if processing then print("processing = true, блок"); return end
    if not anyJumpEnabled() then print("Нет включённых прыжков"); return end

    local cooldown = getValue(cdBox, 5)
    local now = os.clock()
    if lastJumpTime and (now - lastJumpTime < cooldown) then print("Кулдаун"); return end

    print("Прыжок запущен! Кулдаун:", cooldown)
    processing = true
    local char = player.Character
    if not char then print("Нет персонажа"); processing = false; return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then print("Нет HumanoidRootPart"); processing = false; return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then print("Нет Humanoid"); processing = false; return end

    -- Прыжок 1
    if sections[1].checkBtn.Text:sub(1, 1) == "☑" then
        task.wait(getValue(sections[1].delayBox, 0))
        char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local h = getValue(sections[1].heightBox, 25)
            print("Прыжок 1: Height =", h)
            char.HumanoidRootPart.Velocity = Vector3.new(0, h, 0)
        end
    end

    -- Прыжок 2
    if sections[2].checkBtn.Text:sub(1, 1) == "☑" then
        task.wait(getValue(sections[2].delayBox, 0.3))
        char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local h = getValue(sections[2].heightBox, 10)
            print("Прыжок 2: Height =", h)
            char.HumanoidRootPart.Velocity = Vector3.new(0, h, 0)
        end
    end

    -- Прыжок 3
    if sections[3].checkBtn.Text:sub(1, 1) == "☑" then
        task.wait(getValue(sections[3].delayBox, 0.2))
        char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local h = getValue(sections[3].heightBox, 50)
            print("Прыжок 3: Height =", h)
            char.HumanoidRootPart.Velocity = Vector3.new(0, h, 0)
        end
    end

    lastJumpTime = os.clock()
    processing = false
    print("Прыжок завершён")
end)
