-- ========== Функция создания секции ==========
local sections = {}

local function createJumpSection(i, yPos, enabled, delay, height)
    local section = Instance.new("Frame")
    section.Size = UDim2.new(1, -10, 0, 55)
    section.Position = UDim2.new(0, 5, 0, yPos)
    section.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    section.BorderSizePixel = 0
    section.Parent = frame

    local checkBtn = Instance.new("TextButton")
    checkBtn.Size = UDim2.new(0, 55, 0, 20)
    checkBtn.Position = UDim2.new(0, 5, 0, 3)
    checkBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    checkBtn.Text = (enabled and "☑ " or "☐ ") .. "J" .. i
    checkBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    checkBtn.Font = Enum.Font.SourceSansBold
    checkBtn.TextScaled = true
    checkBtn.Parent = section

    checkBtn.MouseButton1Click:Connect(function()
        local isEnabled = checkBtn.Text:sub(1, 1) == "☑"
        checkBtn.Text = (isEnabled and "☐ " or "☑ ") .. "J" .. i
    end)

    local delayLbl = Instance.new("TextLabel")
    delayLbl.Size = UDim2.new(0, 30, 0, 20)
    delayLbl.Position = UDim2.new(0, 65, 0, 3)
    delayLbl.BackgroundTransparency = 1
    delayLbl.Text = "Time:"
    delayLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    delayLbl.TextScaled = true
    delayLbl.Parent = section

    local delayBox = Instance.new("TextBox")
    delayBox.Size = UDim2.new(0, 40, 0, 20)
    delayBox.Position = UDim2.new(0, 98, 0, 3)
    delayBox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    delayBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    delayBox.Text = tostring(delay)
    delayBox.Parent = section

    local heightLbl = Instance.new("TextLabel")
    heightLbl.Size = UDim2.new(0, 35, 0, 20)
    heightLbl.Position = UDim2.new(0, 145, 0, 3)
    heightLbl.BackgroundTransparency = 1
    heightLbl.Text = "Height:"
    heightLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    heightLbl.TextScaled = true
    heightLbl.Parent = section

    local heightBox = Instance.new("TextBox")
    heightBox.Size = UDim2.new(0, 50, 0, 20)
    heightBox.Position = UDim2.new(0, 185, 0, 3)
    heightBox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    heightBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    heightBox.Text = tostring(height)
    heightBox.Parent = section

    sections[i] = {checkBtn = checkBtn, delayBox = delayBox, heightBox = heightBox}
end

createJumpSection(1, 70, true, 0, 25)
createJumpSection(2, 130, true, 0.3, 10)
createJumpSection(3, 190, false, 0.2, 50)

