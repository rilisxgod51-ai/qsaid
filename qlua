-- ========== Конфиг ==========
local defaultConfig = {
    jumps = {
        {enabled = true, delay = 0.5, height = 50},
        {enabled = true, delay = 0.2, height = 50},
        {enabled = true, delay = 0.2, height = 50}
    },
    cooldown = 3
}

local config = nil -- текущий конфиг

-- Функция применяет конфиг к GUI
local function applyConfig(cfg)
    for i = 1, 3 do
        local jumpCfg = cfg.jumps[i]
        local section = sections[i]
        section.checkBtn.Text = jumpCfg.enabled and ("☑ J" .. i) or ("☐ J" .. i)
        section.delayBox.Text = tostring(jumpCfg.delay)
        section.heightBox.Text = tostring(jumpCfg.height)
    end
    cdBox.Text = tostring(cfg.cooldown)
end

-- Функция собирает значения из GUI в таблицу
local function collectConfig()
    local result = {jumps = {}}
    for i = 1, 3 do
        local section = sections[i]
        result.jumps[i] = {
            enabled = section.checkBtn.Text:sub(1, 1) == "☑",
            delay = tonumber(section.delayBox.Text) or defaultConfig.jumps[i].delay,
            height = tonumber(section.heightBox.Text) or defaultConfig.jumps[i].height
        }
    end
    result.cooldown = tonumber(cdBox.Text) or defaultConfig.cooldown
    return result
end

-- Сохранение в файл
local function saveConfig()
    if not canSave then
        warn("Ваш инжектор не поддерживает writefile/readfile")
        return
    end
    local json = HttpService:JSONEncode(collectConfig())
    writefile("JumpMacroConfig.json", json)
    print("Конфиг сохранён в JumpMacroConfig.json")
end

-- Загрузка из файла
local function loadConfig()
    if not canSave then
        config = defaultConfig
        applyConfig(config)
        return
    end
    
    local success, data = pcall(readfile, "JumpMacroConfig.json")
    if success and data then
        local decoded = HttpService:JSONDecode(data)
        config = decoded
        applyConfig(config)
        print("Конфиг загружен из файла")
    else
        config = defaultConfig
        applyConfig(config)
        print("Конфиг не найден, используем значения по умолчанию")
    end
end

