-- ========== Логика прыжков ==========
local processing = false
local lastJumpTime = nil
local pressedKeys = {}

UserInputService.InputBegan:Connect(function(input, gp)
    if not gp then pressedKeys[input.KeyCode] = true end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if not gp then pressedKeys[input.KeyCode] = nil end
end)

local function getValue(box, default)
    local val = tonumber(box.Text)
    if val == nil or val < 0 then return default end
    return val
end

local function anyJumpEnabled()
    for i = 1, 3 do
        if sections[i].checkBtn.Text:sub(1, 1) == "☑" then return true end
    end
    return false
end

UserInputService.InputBegan:Connect(function(input, gp)
    if input.KeyCode ~= Enum.KeyCode.Q or gp or not enabled then return end

    for key, _ in pairs(pressedKeys) do
        if key ~= Enum.KeyCode.Q then return end
    end
    if processing then return end
    if not anyJumpEnabled() then return end

    local cooldown = getValue(cdBox, 3)
    local now = os.clock()
    if lastJumpTime and (now - lastJumpTime < cooldown) then return end

    processing = true
    local char = player.Character

    -- Проверяем каждый прыжок
    for i = 1, 3 do
        local section = sections[i]
        if section.checkBtn.Text:sub(1, 1) == "☑" then
            task.wait(getValue(section.delayBox, defaultConfig.jumps[i].delay))
            char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.Velocity = Vector3.new(0, getValue(section.heightBox, defaultConfig.jumps[i].height), 0)
            end
        end
    end

    lastJumpTime = os.clock()
    processing = false
end)

