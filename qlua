-- ========== Логика сворачивания ==========
local expanded = true
local normalHeight = frame.Size.Y.Offset

local function toggleCollapse()
    expanded = not expanded
    collapseBtn.Text = expanded and "–" or "+"

    if expanded then
        frame.Size = UDim2.new(0, 250, 0, normalHeight)
    else
        frame.Size = UDim2.new(0, 250, 0, 30)
    end

    -- Скрываем или показываем все элементы, кроме title и collapseBtn
    for _, child in ipairs(frame:GetChildren()) do
        if child ~= title and child ~= collapseBtn then
            child.Visible = expanded
        end
    end
end

collapseBtn.MouseButton1Click:Connect(toggleCollapse)

